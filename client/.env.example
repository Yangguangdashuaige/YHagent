# ==================== 桌宠客户端配置模板（yhagent-client） ====================
# 使用方法：复制本文件重命名为 .env 放到 exe 同目录。.env 已被 Git 忽略。

# 远端 Agent 服务地址（正式环境请使用 https）
REMOTE_BASE_URL=http://127.0.0.1:8080

# 访问令牌，必须与服务端 SERVER_TOKEN 一致
REMOTE_TOKEN=请替换为与服务端一致的访问令牌

# ---------- 桌宠窗口（可选，缺省值开箱即用） ----------

# 带状窗高度（物理像素）：宠物活动区 + 气泡空间
# PET_BAND_HEIGHT=260
# 窗口底边离工作区底边间隙（物理像素，0=贴任务栏，负值=覆盖任务栏）
# PET_BOTTOM_GAP=3

# ---------- 按键说话 / 语音听写（可选） ----------

# 按住说话（GetAsyncKeyState 轮询，默认开；关掉则只用手动输入）
# PTT_ENABLED=1
# PTT 虚拟键码（十进制；默认 164=左 Alt。165=右 Alt，162=左 Ctrl，32=空格）
# PTT_KEY_VK=164
# 听写结束自动发送（Coopanion 行为：说完即问；关闭则填入输入框待确认）
# ASR_AUTO_SEND=1
