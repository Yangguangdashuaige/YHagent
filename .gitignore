# ==================== 敏感文件 绝对禁止提交到Git ====================
.env
.env.local
*.key
*.pem
run.sh
deploy.sh

# ==================== Go编译/运行忽略项 ====================
main
*.exe
*.dll
*.so
*.dylib
*.out
*.test
vendor/

# 交叉编译出的 Linux 服务端产物
yhagent-server

# deploy/build.ps1 的打包暂存与产物
deploy/yhagent-deploy/
deploy/*.tar.gz

# 数据帝全物品接口原始响应缓存（20点资源/次，避免重复拉取）
server/.cache/

# 运行时数据与知识库源文档（内容已编入 index.gob，md 源文件仅存本机）
server/data/

# ==================== Wails构建产物（客户端位于 client/ 子目录） ====================
**/build/bin/

# ==================== 编辑器/系统垃圾文件 ====================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log